# Copy to .env and fill in. Never commit .env.

# platform.openai.com/api-keys. Needs credit: translation costs $0.034 a
# minute (about Rs 3) per English listener per Hindi/Telugu speaker, for
# as long as the call lasts -- silence included.
OPENAI_API_KEY=

# aistudio.google.com/apikey. Only needed for meetings that use Gemini 3.5
# Live Translate.
GEMINI_API_KEY=

# TURN relay for the video call, for networks that block direct
# browser-to-browser connections. Optional. ExpressTURN's free tier
# (expressturn.com) -- the same login as Meet Translate works.
# TURN_URL=turn:free.expressturn.com:3478
# TURN_USERNAME=
# TURN_PASSWORD=

# Only used by the *.service.spec.ts tests, to point at a fake server.
# OPENAI_BASE_URL=
# GEMINI_BASE_URL=

# Ports 4100/3100 (not 4000/3000), so this runs next to Meet Translate.
PORT=4100
FRONTEND_URL=http://localhost:3100

# For a public link (leave unset locally): needed to create a meeting, so a
# stranger with the address can't run up the OpenAI bill.
# ACCESS_CODE=
